# Copy to .env and fill in. Permissions: chmod 600 .env

# --- Required ---

# Gmail address and an app password (not the regular password!):
# https://myaccount.google.com/apppasswords — requires 2-Step Verification
IMAP_USER=you@gmail.com
IMAP_PASSWORD=

# Bot token from @BotFather and the id of your chat with the bot (the README tells how to find it out)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional (defaults shown) ---

# SCAN_INTERVAL_MIN=1
# TZ=Asia/Nicosia
# OLLAMA_MODEL=gemma4:e4b
# Language the model writes summaries in (any language name the model understands)
# SUMMARY_LANGUAGE=Russian
# IMAP_HOST=imap.gmail.com
